# Core
NODE_ENV=production
APP_URL=https://app.taskpilot.example
API_URL=https://api.taskpilot.example

# Database
DATABASE_URL=postgresql://user:pass@host:5432/taskpilot
REDIS_URL=redis://host:6379/0

# Storage
S3_ENDPOINT=https://s3.example
S3_BUCKET=taskpilot-artifacts
S3_ACCESS_KEY=...
S3_SECRET_KEY=...

# Auth
JWT_SECRET=...
COOKIE_SECRET=...

# OAuth (per provider)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...
STRIPE_API_KEY=...
STRIPE_WEBHOOK_SECRET=...

# AI Providers
LLM_PROVIDER=openai
OPENAI_API_KEY=...
